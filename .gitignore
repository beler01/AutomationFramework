# IDE
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.class
*.jar
*.war
*.ear
*.sublime-project
*.sublime-workspace

# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml

# Build and compilation
/build/
.gradle/
*.gradle

# Test Reports
reports/
test-output/
test-reports/

# Screenshots
screenshots/

# Logs
logs/
*.log

# System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Test execution
.testng/
*.properties.bak

# Environment files
.env
.env.local
.env.*.local

# Temporary files
*.tmp
*.temp
*~
*.swp
*.swo

# Node modules (if using Node.js for any auxiliary tools)
node_modules/
npm-debug.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Docker
.dockerignore
Dockerfile

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Misc
.classpath
.project
.settings/
*.iml
.metadata
local.properties
*.bak
